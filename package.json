{
  "name": "shared-list",
  "version": "1.0.0",
  "private": true,
  "description": "Password-protected lists you share as a link, with per-list CSS and an MCP server so AI agents can build and edit them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/index.ts & vite",
    "start": "node server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
